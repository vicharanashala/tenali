# CompreFace — face verification (optional, leave empty to skip)
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=

# MongoDB
MONGO_URI=mongodb://localhost:27017/tenali

# JWT
JWT_SECRET=your-secret-here

# Seed logins — comma-separated "username:password[:role]" entries.
# Add ":admin" to exactly one entry for proctor-dashboard access.
# Keep the real values only in the deployed .env, never here.
TENALI_SEED_USERS=user1:pass1,user2:pass2,admin:adminpass:admin

# Google Cloud Translation — used by /api/translate to translate UI text not
# covered by the bundled locale dictionaries. If unset, /api/translate is a
# passthrough (returns original text untranslated).
GOOGLE_TRANSLATE_API_KEY=

# Server (local development default)
PORT=4000

# Production runs one process per app, one port per app. The public prefix
# belongs to nginx (see server/deploy/tenali-nginx.conf), so every app runs
# with SUBPATH_REDIRECT=/ and never redirects its own "/" — otherwise the
# browser bounces between nginx and Express forever.
#
# main app           → PORT=4001  SUBPATH_REDIRECT=/  VITE_BASE_PATH=/summership/
# root app           → PORT=4003  SUBPATH_REDIRECT=/  VITE_BASE_PATH=/
# matrixmystics app  → PORT=4004  SUBPATH_REDIRECT=/  VITE_BASE_PATH=/matrixmystics/

