[Unit]
Description=Tenali main app (summership) — branch main, port 4001
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tenali
Group=tenali
WorkingDirectory=/home/tenali/tenali
# Refuse to start on an unpatched Node.js. The floor lives in .nvmrc
# (see server/deploy/check-node-version.js); 24.22.1 carries the October
# 21, 2026 security fixes, including CVE-2026-111497.
ExecStartPre=/usr/bin/node /home/tenali/tenali/server/deploy/check-node-version.js
ExecStart=/usr/bin/node /home/tenali/tenali/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=NODE_ENV=production
Environment=PORT=4001
Environment=SUBPATH_REDIRECT=/summership
EnvironmentFile=-/home/tenali/tenali/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tenali-main

[Install]
WantedBy=multi-user.target
